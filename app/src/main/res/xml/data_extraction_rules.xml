<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml — same reasoning: exclude
     everything by default so the encrypted token store never leaves the
     device via cloud backup or device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
    </cloud-backup>
    <device-transfer>
    </device-transfer>
</data-extraction-rules>
